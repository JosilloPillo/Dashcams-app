<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_brand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/title"
            style="@style/Dashcams.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="34sp" />

        <!-- ===== Grabación ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_recording" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSound"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_sound" />

        <TextView
            android:id="@+id/soundNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBeep"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_beep" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFit"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_fit" />

        <TextView
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_fit_note" />

        <!-- ===== Cámara ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_camera" />

        <RadioGroup
            android:id="@+id/cameraGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioRoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_camera_road"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radioInside"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_camera_inside"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/bothNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Voz ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_voice" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVoice"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_voice_switch" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/voiceProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/voiceNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
