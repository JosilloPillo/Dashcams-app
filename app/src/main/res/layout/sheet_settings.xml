<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_brand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/title"
            style="@style/Dashcams.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="34sp" />

        <!-- ===== Grabación ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_recording" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSound"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_sound" />

        <TextView
            android:id="@+id/soundNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBeep"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_beep" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFit"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_fit" />

        <TextView
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_fit_note" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoDark"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_dark" />

        <TextView
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_dark_note" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLimit"
            style="@style/Dashcams.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tab"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/limitNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Datos dentro del vídeo ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_overlay" />

        <TextView
            android:id="@+id/overlayNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSpeed"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_overlay_speed" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCoords"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_overlay_coords" />

        <TextView
            android:id="@+id/locationNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Segundo plano ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_background" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBackground"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_background_switch" />

        <TextView
            android:id="@+id/backgroundNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBattery"
            style="@style/Dashcams.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tab"
            android:text="@string/settings_battery_button"
            android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBubble"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_bubble_switch" />

        <TextView
            android:id="@+id/bubbleNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Cámara ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_camera" />

        <RadioGroup
            android:id="@+id/cameraGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioRoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_camera_road"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radioInside"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_camera_inside"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radioBoth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_camera_both"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/bothNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Voz ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_voice" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVoice"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_voice_switch" />

        <TextView
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_voice_phrase" />

        <RadioGroup
            android:id="@+id/phraseGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/phraseEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/phrase_emergency"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/phraseRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/phrase_red"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/phraseAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/phrase_alert"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/voiceProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/voiceNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Icono de la app ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_icon" />

        <TextView
            android:id="@+id/iconNote"
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_icon_note" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/iconRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ===== Dashcams España ===== -->
        <TextView
            style="@style/Dashcams.SettingsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashcams España" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchReports"
            style="@style/Dashcams.SettingsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reports_switch" />

        <TextView
            style="@style/Dashcams.SettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reports_note" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrivacy"
            style="@style/Dashcams.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tab"
            android:text="Política de privacidad"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWelcome"
            style="@style/Dashcams.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tab"
            android:text="Consejos, canales y tienda"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
