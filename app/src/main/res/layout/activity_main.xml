<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_profundo">

    <!-- Vista de cámara a pantalla completa (en Ajustes se puede ver el encuadre entero con bandas) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Ventanita con el interior del coche, solo cuando se graban las dos cámaras -->
    <FrameLayout
        android:id="@+id/insideFrame"
        android:layout_width="176dp"
        android:layout_height="99dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_inside_frame"
        android:padding="2dp"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/insidePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />
    </FrameLayout>

    <!-- Degradados azul marino arriba y abajo para que se lean los controles sobre la imagen -->
    <View
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== Arriba: marca · kicker REC · temperatura ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/escudo" />

                <TextView
                    android:id="@+id/brandText"
                    style="@style/Dashcams.Wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Kicker: punto rojo que parpadea como un REC + estado -->
            <LinearLayout
                android:id="@+id/kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <View
                    android:id="@+id/recDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/rec_dot"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/statusText"
                    style="@style/Dashcams.KickerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/status_starting" />
            </LinearLayout>

            <TextView
                android:id="@+id/tempText"
                style="@style/Dashcams.KickerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp" />
        </FrameLayout>

        <!-- ===== Abajo: botones ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStartStop"
                style="@style/Dashcams.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/record"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSettings"
                style="@style/Dashcams.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                style="@style/Dashcams.Cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:text="@string/save"
                android:textSize="22sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnClips"
                style="@style/Dashcams.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clips"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDark"
                style="@style/Dashcams.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/dark"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== Banner de Dashcams España al abrir la app (la grabación sigue debajo) ===== -->
        <FrameLayout
            android:id="@+id/promo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:elevation="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/promoImage"
                android:layout_width="440dp"
                android:layout_height="231dp"
                android:contentDescription="Promoción de Dashcams España"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/promoCta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_cta"
                android:fontFamily="@font/public_sans_semibold"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="@color/azul_marino"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/promoClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_pill_dark"
                android:contentDescription="Cerrar"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </FrameLayout>

        <!-- ===== Aviso "Clip guardado": chip blanco con check verde que entra con rebote ===== -->
        <LinearLayout
            android:id="@+id/savedChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/saved_chip_title"
                    android:textColor="@color/azul_marino"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/public_sans_regular"
                    android:text="@string/saved_chip_text"
                    android:textColor="@color/marino_suave"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Modo pantalla negra: tapa todo y baja el brillo al mínimo para que el móvil se caliente menos.
         Sigue grabando por debajo. Tocar en cualquier sitio lo quita. -->
    <LinearLayout
        android:id="@+id/darkOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="46dp"
            android:alpha="0.3"
            android:contentDescription="@null"
            android:src="@drawable/escudo" />

        <TextView
            android:id="@+id/darkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/public_sans_regular"
            android:textColor="@color/texto_tenue"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
