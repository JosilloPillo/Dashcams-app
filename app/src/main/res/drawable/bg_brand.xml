    <gradient
        android:type="radial"
        android:centerX="0.8"
        android:centerY="0"
        android:gradientRadius="900dp"
        android:startColor="@color/azul_luz"
        android:centerColor="@color/azul_marino"
        android:endColor="@color/fondo_profundo" />
</shape>
